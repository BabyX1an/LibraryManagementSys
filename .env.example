# Library Management System - local development environment
#
# Copy this file to .env, replace every placeholder, and export the values
# before starting the services:
#   cp .env.example .env
#   set -a && source .env && set +a
#
# Do not commit .env. Quote values that contain spaces or shell characters.

# -----------------------------------------------------------------------------
# MySQL - Spring Boot services
# -----------------------------------------------------------------------------
SPRING_DATASOURCE_URL="jdbc:mysql://localhost:3306/library_system?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=GMT%2B8&allowPublicKeyRetrieval=true"
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change_me

# MySQL - Python AI service
DB_HOST=localhost
DB_PORT=3306
DB_NAME=library_system
DB_USER=root
DB_PASSWORD=change_me

# -----------------------------------------------------------------------------
# Redis - Spring Boot services
# -----------------------------------------------------------------------------
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_DATABASE=0

# Redis - Python AI service (a separate logical database is used for vectors)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# -----------------------------------------------------------------------------
# Nacos - Spring Cloud services
# Create a namespace in Nacos and replace your_nacos_namespace_id everywhere.
# -----------------------------------------------------------------------------
SPRING_CLOUD_NACOS_USERNAME=nacos
SPRING_CLOUD_NACOS_PASSWORD=nacos
SPRING_CLOUD_NACOS_DISCOVERY_SERVER_ADDR=localhost:8848
SPRING_CLOUD_NACOS_DISCOVERY_NAMESPACE=your_nacos_namespace_id
SPRING_CLOUD_NACOS_DISCOVERY_GROUP=DEFAULT_GROUP
SPRING_CLOUD_NACOS_CONFIG_SERVER_ADDR=localhost:8848
SPRING_CLOUD_NACOS_CONFIG_NAMESPACE=your_nacos_namespace_id
SPRING_CLOUD_NACOS_CONFIG_GROUP=DEFAULT_GROUP

# Nacos - Python AI service
NACOS_SERVER=localhost:8848
NACOS_NAMESPACE=your_nacos_namespace_id
NACOS_GROUP=DEFAULT_GROUP
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# -----------------------------------------------------------------------------
# AI service
# -----------------------------------------------------------------------------
SERVICE_NAME=ai-service
SERVICE_PORT=8108
BERT_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_KEY=book:embeddings
EMBEDDING_DIM=384

# -----------------------------------------------------------------------------
# Book-cover storage
# Use an absolute directory. Quote the value in .env if the path has spaces.
# -----------------------------------------------------------------------------
APP_IMAGE_LOCATION=/absolute/path/to/library-images
